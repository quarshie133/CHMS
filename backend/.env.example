# Django
DJANGO_SECRET_KEY=super-secret-change-this-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
FRONTEND_URL=http://localhost:3000

# Database
POSTGRES_DB=churchms
POSTGRES_USER=churchms
POSTGRES_PASSWORD=churchms_pass
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://redis:6379/0

# JWT
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Email (configure for production)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@churchms.com

# SMS — AgooSMS (see docs/SMS_AGOOSMS.md). Never commit real values.
AGOOSMS_BASE_URL=https://api.agoosms.com
AGOOSMS_API_KEY=
# Production alternative to AGOOSMS_API_KEY (set one):
AGOOSMS_API_KEY_SSM_PARAMETER=
AGOOSMS_API_KEY_SECRET_ID=
AWS_REGION=
# Approved sender ID(s), comma-separated; first is the default (max 11 chars each)
AGOOSMS_SENDER_ID=
AGOOSMS_TIMEOUT=30
AGOOSMS_MAX_BULK=100
# True = test mode: messages are recorded as "simulated", nothing is sent.
SMS_DRY_RUN=True
SMS_LARGE_BROADCAST_THRESHOLD=25
SMS_MAX_RECIPIENTS=5000
SMS_MAX_MESSAGE_LENGTH=918
SMS_SEND_RATE=20/hour

# S3 / MinIO Storage (set USE_S3=True to enable)
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=churchms
AWS_S3_ENDPOINT_URL=http://minio:9000
AWS_S3_CUSTOM_DOMAIN=
